name: MIND FORGE - Vertical Video

on:
  workflow_run:
    workflows:
      - "MIND FORGE - Script and Voice"
    types:
      - completed

permissions:
  actions: read
  contents: read

jobs:
  render-video:
    if: ${{ github.event.workflow_run.conclusion == 'success' }}
    runs-on: ubuntu-24.04

    steps:
      - name: Get the same project version that made the script and voice
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}

      - name: Download script and voice from the completed run
        uses: actions/download-artifact@v5
        with:
          name: mind-forge-video-assets
          path: source-assets
          run-id: ${{ github.event.workflow_run.id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}

      - name: Install free video tools and fonts
        run: |
          sudo apt-get update
          sudo apt-get install --yes ffmpeg fonts-dejavu-core

      - name: Render vertical video and captions
        run: python render_vertical_video.py --assets source-assets --output output

      - name: Save the finished video bundle
        uses: actions/upload-artifact@v4
        with:
          name: mind-forge-vertical-video
          path: output/
          if-no-files-found: error
          retention-days: 7
